# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-grande
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.exemplo

# Captura / web
MAX_CAPTURE_CHARS=200000
WEB_FETCH_TIMEOUT=20

# Groq: transcrição
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TRANSCRIBE_MEDIA=1
TRANSCRIPTION_LANGUAGE=pt
MAX_TRANSCRIPTION_BYTES=25165824

# OCR visual de Instagram
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
ANALYZE_IMAGES=1
MAX_INSTAGRAM_IMAGES=20
MAX_VISION_IMAGE_BYTES=15728640

# Análise textual
GROQ_CHAT_MODEL=openai/gpt-oss-20b
ANALYZE_CONTENT=1
AI_TIMEOUT=120

# Para PostgreSQL via Docker Compose, descomente:
# DATABASE_URL=postgresql://segundo:segundo@localhost:5432/segundo_cerebro


# Busca semântica / RAG
SEMANTIC_SEARCH_ENABLED=1
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=20
SEMANTIC_CHUNK_CHARS=1400
SEMANTIC_TOP_K=24
SEMANTIC_MIN_SCORE=0.20
RAG_CANDIDATE_TOP_K=12
RAG_TOP_K=5
RAG_MAX_CHUNKS_PER_ITEM=2
RAG_RELATIVE_SCORE_DROP=0.12
